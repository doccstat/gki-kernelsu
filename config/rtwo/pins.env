# Motorola Edge+ 2023 (rtwo) / LineageOS source identity.
# The kernel commit is the exact commit encoded by the connected phone's
# 5.15.208-ge3f43b79f663 release string.
RTWO_DEVICE=rtwo
RTWO_PLATFORM=kalama
ANDROID_KERNEL_FAMILY=android13-5.15
KERNEL_VERSION=5.15.208
KERNEL_RELEASE=5.15.208-android13

LINEAGE_FINGERPRINT=motorola/rtwo_g/msi:16/TTR3S3HV-W1-ST34/cb3b97-65907:user/release-keys
LINEAGE_SECURITY_PATCH=2026-08-01
LINEAGE_KERNEL_RELEASE=5.15.208-ge3f43b79f663

# Matching LineageOS boot image used as the packaging base. This is the
# standalone boot.img published for the 2026-08-22 rtwo build, rather than the
# much larger OTA zip. Keep this in lockstep with the fingerprint and source
# manifest below when updating the device baseline.
LINEAGE_BUILD_DATE=20260822
LINEAGE_BUILD_VERSION=23.2
LINEAGE_BOOT_URL=https://mirrorbits.lineageos.org/full/rtwo/20260822/boot.img
LINEAGE_BOOT_SHA256=19e22bfd013f6cc934c5ee667084cc678b8601237a8dfd346c031fbf1e708f08

# AOSP boot-image tooling used to unpack the pinned base and repack its v4
# header around the newly built common GKI Image.
MKBOOTIMG_REPO=https://android.googlesource.com/platform/system/tools/mkbootimg
MKBOOTIMG_REF=167f905b0c2bf311fedb039e8b30840176750ae8

# Lineage's Qualcomm/Kalama kernel and the external module/devicetree trees
# from the 2026-08-22 rtwo build manifest. This project builds only the common
# GKI Image and leaves the phone's vendor modules stock.
KERNEL_REPO=https://github.com/LineageOS/android_kernel_motorola_sm8550.git
KERNEL_REF=f957779e27df2fc45c38539527de6cd6b0f2b3b0
MODULES_REPO=https://github.com/LineageOS/android_kernel_motorola_sm8550-modules.git
MODULES_REF=6cc9bfcd5850b4c0e5a80fe17ec5bfaf7eb8d9be
DEVICETREES_REPO=https://github.com/LineageOS/android_kernel_motorola_sm8550-devicetrees.git
DEVICETREES_REF=a00e7129aa09aa7d6328e1992d59109198fbef64

# These device-tree repositories document the userspace/vendor baseline. They
# are recorded for auditability; the kernel build itself needs only KERNEL_REPO
# plus the external module tree above.
LINEAGE_DEVICE_REPO=https://github.com/LineageOS/android_device_motorola_rtwo.git
LINEAGE_DEVICE_REF=409ef5f7c387cafc8b6cdd302e44427161363042
LINEAGE_COMMON_REPO=https://github.com/LineageOS/android_device_motorola_sm8550-common.git
LINEAGE_COMMON_REF=ba249c2321d629846526d076ab66f25af185f3aa

# Root implementations. KPM and SUSFS remain separate variants because no
# reviewed combined SukiSU-Ultra/ReSukiSU integration is pinned here.
SUKISU_REPO=https://github.com/SukiSU-Ultra/SukiSU-Ultra.git
SUKISU_REF=0ca744a88835144c58d8256ebb32c279edabfcde
RESUKISU_REPO=https://github.com/ReSukiSU/ReSukiSU.git
RESUKISU_REF=3ef06b0fcb0960dc9563256fe26a58e892663387

# WildKernels' verified Android 13/5.15 SUSFS pin, with the upstream patch
# carried in the branch itself.
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=gki-android13-5.15
SUSFS_REF=ccb1918684b27644d17a6c842f57b60ae5966025
SUSFS_PATCH=kernel_patches/50_add_susfs_in_gki-android13-5.15.patch
